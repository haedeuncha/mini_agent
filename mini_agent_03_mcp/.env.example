BACKEND_API_URL=http://127.0.0.1:8000
TRAVEL_MCP_URL=http://127.0.0.1:8010/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8010
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Docker Compose에서 호스트에 공개하는 고정 포트다. 다른 값으로 바꾸지 않는다.
BACKEND_PORT=8000
FRONTEND_PORT=8501

# compose.release.yml은 사전에 Registry에 게시된 세 이미지를 받아 실행한다.
TRAVEL_MCP_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=
